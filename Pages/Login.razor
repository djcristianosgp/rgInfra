@page "/login"

@inject NavigationManager Navigation
@inject HttpClient Http
@inject ILocalStorageService LocalStorage


<EditForm Model="@loginModel" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    <div class="login-container">
        <h3>Login</h3>

        <div class="form-group">
            <label for="login">Email</label>
            <InputText id="login" class="form-control" @bind-Value="loginModel.login" />
            <ValidationMessage For="@(() => loginModel.login)" />
        </div>

        <div class="form-group">
            <label for="senha">Senha</label>
            <InputText id="senha" type="password" class="form-control" @bind-Value="loginModel.senha" />
            <ValidationMessage For="@(() => loginModel.senha)" />
        </div>

        <button type="submit" class="btn btn-primary">Login</button>
    </div>
</EditForm>

@code {
    private LoginApiViewModel.RequestLogin loginModel = new LoginApiViewModel.RequestLogin();

    private async Task HandleValidSubmit()
    {
        var response = await Http.PostAsJsonAsync("https://service-identidadeapi.azurewebsites.net/api/auth/login", loginModel);
        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<LoginApiViewModel.ResponseLogin>();
            if (result != null)
            {
                await LocalStorage.SetItemAsync("accessToken", result.accessToken);
                await LocalStorage.SetItemAsync("refreshToken", result.refreshToken);
                Navigation.NavigateTo("/home");
            }
        }
        else
        {
            // Handle login failure
            Console.WriteLine("Login failed");
        }
    }
}
